# All ML model assets and binary blobs provisioned by setup_libs.sh.
# Only small hand-crafted text assets (homophones.json, viseme_map*.txt)
# are tracked; everything else is downloaded at build time.
app/src/main/assets/*.tflite
app/src/main/assets/*.onnx
app/src/main/assets/*.task
app/src/main/assets/*.bin
app/src/main/assets/*.json
!app/src/main/assets/homophones.json
app/src/main/assets/unigram5000_units.txt
app/src/main/assets/syncvsr_unigram_units.txt
app/src/main/assets/avhubert_base_vox_433h_dict.txt

# OpenCV Android SDK (re-downloaded by setup_libs.sh)
app/src/main/cpp/libs/opencv/

# KenLM Android prebuilts (pulled from HF by setup_libs.sh)
app/src/main/cpp/kenlm/
/nul
