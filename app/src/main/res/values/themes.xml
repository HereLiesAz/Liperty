<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- DayNight follows AppCompatDelegate.setDefaultNightMode(), which
         LipertyApplication wires up from the "dark_theme" pref so the
         XML-based SettingsActivity respects the same toggle that
         LipertyTheme uses on the Compose side. -->
    <style name="Theme.Liperty" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryDark">@color/purple_700</item>
        <item name="colorAccent">@color/teal_200</item>
        <!-- Customize your theme here. -->
    </style>
</resources>
